# TradingGPT exchange execution
#
# Safe defaults:
# - PAPER execution remains available.
# - Binance execution is disabled.
# - Live trading is disabled.
ENABLE_BINANCE_EXECUTION=false
BINANCE_TESTNET=true
ENABLE_REAL_TRADING=false

# Account-scoped Binance Testnet risk guard
TESTNET_ORDER_EXECUTION_ENABLED=true
TESTNET_MAX_ORDER_NOTIONAL=100
# UTC daily total for accepted non-dry-run orders.
TESTNET_MAX_DAILY_NOTIONAL=500
# OPEN and PARTIALLY_FILLED orders per account.
TESTNET_MAX_OPEN_ORDERS=5
# Empty means all exchange-supported symbols.
# Example: BTCUSDT,ETHUSDT
TESTNET_ALLOWED_SYMBOLS=

# Binance Spot Testnet credentials
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Binance live credentials
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Telegram publisher for real trading signals.
# Keep disabled until a dry-run verification succeeds.
TELEGRAM_SIGNAL_ENABLED=false
TELEGRAM_SIGNAL_BOT_TOKEN=
TELEGRAM_SIGNAL_CHAT_ID=
TELEGRAM_SIGNAL_TIMEOUT_SECONDS=10
TELEGRAM_SIGNAL_DISPATCH_POLL_SECONDS=10
TELEGRAM_SIGNAL_BATCH_SIZE=20
TELEGRAM_SIGNAL_MAX_ATTEMPTS=5
TELEGRAM_SIGNAL_RETRY_BASE_SECONDS=30
TELEGRAM_SIGNAL_PROCESSING_LEASE_SECONDS=300
TELEGRAM_SIGNAL_ADVISORY_LOCK_KEY=2026082701

# Read-only Binance Testnet order reconciliation
ORDER_RECONCILIATION_BACKGROUND_ENABLED=false
ORDER_RECONCILIATION_POLL_SECONDS=15
ORDER_RECONCILIATION_BATCH_SIZE=50
ORDER_RECONCILIATION_HISTORY_LIMIT=100000
ORDER_RECONCILIATION_ADVISORY_LOCK_KEY=2026082101
