# Copy to .env.production and replace every placeholder.
# Never commit .env.production.

POSTGRES_USER=signalai_app
POSTGRES_DB=signalai
POSTGRES_PASSWORD=replace-with-long-url-safe-password
DATABASE_URL=postgresql+psycopg2://signalai_app:replace-with-long-url-safe-password@db:5432/signalai
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-at-least-64-random-characters
EXCHANGE_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-valid-encryption-key

GRAFANA_ADMIN_USER=signalai_admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001

SCHEDULER_BACKGROUND_LOOP_ENABLED=false
SIGNAL_TRACKING_ENABLED=true
SIGNAL_SCANNER_BACKGROUND_ENABLED=false
ORDER_RECONCILIATION_BACKGROUND_ENABLED=false

TESTNET_ORDER_EXECUTION_ENABLED=false
ENABLE_BINANCE_EXECUTION=false
BINANCE_TESTNET=true
ENABLE_REAL_TRADING=false

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

TELEGRAM_SIGNAL_ENABLED=false
TELEGRAM_SIGNAL_BOT_TOKEN=
TELEGRAM_SIGNAL_CHAT_ID=
